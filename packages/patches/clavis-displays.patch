+pragma Singleton
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Clavis.Niri 1.0
+import qs.Common
+
+Singleton {
+    id: root
+    property bool primaryInstance: false
+    property bool panelActive: false
+    property var outputs: ({})
+    property var settings: []
+    property string message: ""
+    property int confirmSeconds: 0
+    readonly property bool busy: transaction.running
+    readonly property string script: Paths.systemScriptsDir + "/manage-displays.py"
+    readonly property string configDir: (Quickshell.env("XDG_CONFIG_HOME") || Paths.homeDir + "/.config") + "/clavis"
+    property var policy: ({ primary: "", bar: "all", keystone: "all", sidebar: "active", launcher: "active", screens: {} })
+    property bool policyReady: false
+    readonly property var activeScreen: Brightness.getScreenByName(Niri.currentOutput) || Brightness.activeScreen
+    readonly property var primaryScreen: Brightness.getScreenByName(policy.primary) || (Quickshell.screens.length ? Quickshell.screens[0] : null)
+    readonly property var barScreens: filteredScreens("bar")
+    readonly property var keystoneScreens: filteredScreens("keystone")
+
+    function filteredScreens(component) {
+        const mode = policy[component] || "all";
+        return Quickshell.screens.filter(screen => {
+            if (mode === "none") return false;
+            if (mode === "primary") return primaryScreen && screen.name === primaryScreen.name;
+            if (mode === "custom") return !policy.screens[screen.name] || policy.screens[screen.name][component] !== false;
+            return true;
+        });
+    }
+    property var componentVisibilityBackup: null
+    function toggleComponents() {
+        if (!policyReady) return false;
+        const next = JSON.parse(JSON.stringify(policy));
+        if (next.bar === "none" && next.keystone === "none") {
+            const backup = componentVisibilityBackup || ({ bar: "all", keystone: "all" });
+            next.bar = backup.bar;
+            next.keystone = backup.keystone;
+            componentVisibilityBackup = null;
+        } else {
+            componentVisibilityBackup = ({ bar: next.bar, keystone: next.keystone });
+            next.bar = "none";
+            next.keystone = "none";
+        }
+        policy = next;
+        policyFile.setText(JSON.stringify(next, null, 2));
+        return true;
+    }
+
+    function targetScreen(component, requestedName) {
+        const preference = policy[component] || "active";
+        if (preference === "primary") return primaryScreen;
+        if (preference !== "active") return Brightness.getScreenByName(preference) || primaryScreen;
+        return Brightness.getScreenByName(requestedName || "") || activeScreen;
+    }
+    function setPolicy(key, value) {
+        if (!policyReady) return;
+        const next = JSON.parse(JSON.stringify(policy));
+        next[key] = value;
+        policy = next;
+        policyFile.setText(JSON.stringify(next, null, 2));
+    }
+    function setScreenPolicy(name, key, value) {
+        const next = JSON.parse(JSON.stringify(policy.screens || {}));
+        if (!next[name]) next[name] = {};
+        next[name][key] = value;
+        setPolicy("screens", next);
+    }
+    function refresh() {
+        if (!query.running) query.running = true;
+    }
+    function apply(rows) {
+        if (busy) return;
+        message = "";
+        transaction.command = ["python3", script, "apply", JSON.stringify(rows)];
+        transaction.running = true;
+    }
+    function keep() { if (confirmSeconds > 0) transaction.write("keep\n"); }
+    function revert() { if (confirmSeconds > 0) transaction.write("revert\n"); }
+    onPrimaryInstanceChanged: { if (primaryInstance) restoreTimer.restart(); }
+    onPanelActiveChanged: { if (panelActive) refresh(); }
+    Process {
+        id: query
+        command: ["python3", root.script, "list"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try {
+                    const result = JSON.parse(text);
+                    if (result.event === "outputs") {
+                        root.outputs = result.outputs;
+                        root.settings = result.settings;
+                    } else root.message = result.message;
+                } catch (error) { root.message = String(error); }
+            }
+        }
+    }
+    Process {
+        id: transaction
+        stdinEnabled: true
+        stdout: SplitParser {
+            onRead: data => {
+                try {
+                    const result = JSON.parse(data);
+                    if (result.event === "confirm") root.confirmSeconds = result.seconds;
+                    else if (result.event === "saved") { root.message = qsTr("显示方案已保存，将在登录和插拔后恢复"); root.confirmSeconds = 0; }
+                    else if (result.event === "reverted") { root.message = qsTr("已恢复原显示设置"); root.confirmSeconds = 0; }
+                    else if (result.event === "error") root.message = result.message;
+                } catch (error) { root.message = String(error); }
+            }
+        }
+        onExited: exitCode => {
+            root.confirmSeconds = 0;
+            if (exitCode !== 0 && root.message === "") root.message = qsTr("显示设置进程异常退出");
+            root.refresh();
+        }
+    }
+    Timer {
+        interval: 1000
+        running: root.confirmSeconds > 0
+        repeat: true
+        onTriggered: root.confirmSeconds = Math.max(0, root.confirmSeconds - 1)
+    }
+    Timer {
+        interval: 4000
+        running: root.panelActive && !root.busy
+        repeat: true
+        onTriggered: root.refresh()
+    }
+    Connections {
+        target: Quickshell
+        function onScreensChanged() {
+            if (root.panelActive) root.refresh();
+            if (root.primaryInstance) restoreTimer.restart();
+        }
+    }
+    Timer {
+        id: restoreTimer
+        interval: 1800
+        onTriggered: { if (!restoreProcess.running) restoreProcess.running = true; }
+    }
+    Process {
+        id: restoreProcess
+        command: ["python3", root.script, "restore"]
+        stdout: SplitParser {
+            onRead: data => console.log("Display restore:", data)
+        }
+    }
+    Process {
+        command: ["mkdir", "-p", root.configDir]
+        running: true
+        onExited: exitCode => { if (exitCode === 0) policyFile.reload(); }
+    }
+    FileView {
+        id: policyFile
+        path: root.configDir + "/screen-policy.json"
+        watchChanges: true
+        atomicWrites: true
+        onFileChanged: reload()
+        onLoaded: {
+            try {
+                const next = JSON.parse(text());
+                if (!next.screens || typeof next.screens !== "object") next.screens = {};
+                root.policy = next;
+                root.policyReady = true;
+            } catch (error) { root.message = qsTr("屏幕策略文件读取失败：") + error; }
+        }
+        onLoadFailed: root.policyReady = true
+    }
+}
