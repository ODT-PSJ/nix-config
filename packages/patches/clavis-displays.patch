+"""Exercise display safety with a stateful compositor substitute, without changing hardware."""
+import copy
+import importlib.util
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location('displays', Path(__file__).parents[1] / 'scripts/system/manage-displays.py')
+m = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(m)
+
+
+def fixture():
+    return {name: dict(name=name, make='Test', model=name, serial=None,
+        modes=[dict(width=1920, height=1080, refresh_rate=60000)], current_mode=0,
+        logical=dict(x=index * 1920, y=0, width=1920, height=1080, scale=1, transform='Normal'),
+        vrr_supported=False, vrr_enabled=False) for index, name in enumerate(['A', 'B'])}
+
+
+class DisplayTests(unittest.TestCase):
+    def setUp(self):
+        self.raw = fixture()
+        self.calls = []
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.state = patch.object(m, 'STATE', Path(self.temp.name) / 'displays.json')
+        self.state.start(); self.addCleanup(self.state.stop)
+        self.out = patch.object(m, 'outputs', lambda: copy.deepcopy(self.raw))
+        self.out.start(); self.addCleanup(self.out.stop)
+        self.signals = patch.object(m.signal, 'signal')
+        self.signals.start(); self.addCleanup(self.signals.stop)
+        self.events = patch.object(m, 'emit')
+        self.emit = self.events.start(); self.addCleanup(self.events.stop)
+
+    def test_reject_all_off_before_commands(self):
+        rows = m.snapshot(self.raw)
+        for row in rows: row['enabled'] = False
+        with patch.object(m, 'niri') as command, self.assertRaises(ValueError):
+            m.transaction(rows)
+        command.assert_not_called()
+
+    def test_reject_unsupported_mode_scale_and_rotation(self):
+        for key, value in [('mode', '999x999@60.000'), ('scale', float('nan')), ('transform', 'invalid'), ('x', 0.5), ('vrr', True)]:
+            rows = m.snapshot(self.raw); rows[0][key] = value
+            with self.subTest(key=key), self.assertRaises(ValueError): m.validate(rows, self.raw)
+
+    def test_timeout_and_closed_input_restore_without_saving(self):
+        before = m.snapshot(self.raw)
+        for ready, answer in [([], ''), ([io.StringIO()], ''), ([io.StringIO()], 'revert\n')]:
+            with patch.object(m, 'apply') as apply, patch.object(m.select, 'select', return_value=(ready, [], [])), patch.object(m.sys, 'stdin', io.StringIO(answer)):
+                draft = copy.deepcopy(before); draft[0]['transform'] = '90'
+                m.transaction(draft)
+                self.assertEqual(apply.call_args_list[-1].args[0], before)
+                self.assertTrue(apply.call_args_list[-1].kwargs['best_effort'])
+                self.assertFalse(m.STATE.exists())
+
+    def test_partial_failure_rolls_back(self):
+        with patch.object(m, 'apply', side_effect=[RuntimeError('mode failed'), None]) as apply:
+            m.transaction(m.snapshot(self.raw))
+            self.assertEqual(apply.call_count, 2)
+            self.emit.assert_any_call('error', message='mode failed')
+            self.emit.assert_any_call('reverted')
+
+    def test_keep_persists_disabled_screen_orientation(self):
+        rows = m.snapshot(self.raw)
+        rows[1].update(enabled=False, transform='90', scale=1.5)
+        def apply(_): self.raw['B'].update(logical=None, current_mode=None)
+        with patch.object(m, 'apply', side_effect=apply), patch.object(m.select, 'select', return_value=([1], [], [])), patch.object(m.sys, 'stdin', io.StringIO('keep\n')):
+            m.transaction(rows)
+        saved = {r['name']: r for r in json.loads(m.STATE.read_text())}
+        self.assertEqual(saved['B']['transform'], '90')
+        self.assertEqual(saved['B']['mode'], '1920x1080@60.000')
+        self.assertEqual(saved['B']['scale'], 1.5)
+        self.assertFalse(saved['B']['enabled'])
+
+    def test_save_failure_rolls_back(self):
+        with patch.object(m, 'apply') as apply, patch.object(m, 'save', side_effect=OSError('disk full')), patch.object(m.select, 'select', return_value=([1], [], [])), patch.object(m.sys, 'stdin', io.StringIO('keep\n')):
+            m.transaction(m.snapshot(self.raw))
+            self.assertEqual(apply.call_count, 2)
+            self.emit.assert_any_call('reverted')
+
+    def test_enable_before_disable_and_protect_last_output(self):
+        def command(*args):
+            self.calls.append(args)
+            if args[2] == 'off': self.raw[args[1]]['logical'] = None
+        with patch.object(m, 'niri', side_effect=command):
+            rows = m.snapshot(self.raw); rows[0]['enabled'] = False
+            m.apply(rows)
+            self.assertLess(self.calls.index(('output', 'B', 'on')), self.calls.index(('output', 'A', 'off')))
+            rows[1]['enabled'] = False
+            m.apply(rows)
+        self.assertIsNotNone(self.raw['B']['logical'])
+
+    def test_disconnected_saved_screen_preserved(self):
+        m.save(m.snapshot(self.raw))
+        m.save(m.snapshot({'A': self.raw['A']}))
+        self.assertEqual(len(json.loads(m.STATE.read_text())), 2)
+
+    def test_restore_only_disabled_connected_screen(self):
+        rows = m.snapshot(self.raw); rows[0]['enabled'] = False
+        m.save(rows); del self.raw['B']
+        with patch.object(m.sys, 'argv', ['manage-displays', 'restore']), patch.object(m, 'apply') as apply:
+            m.main()
+            self.assertTrue(apply.call_args.args[0][0]['enabled'])
+
+    def test_restore_does_not_apply_to_replaced_monitor(self):
+        m.save(m.snapshot(self.raw)); self.raw['A']['model'] = 'Replacement'; del self.raw['B']
+        with patch.object(m.sys, 'argv', ['manage-displays', 'restore']), patch.object(m, 'apply') as apply:
+            m.main(); apply.assert_not_called()
+
+
+if __name__ == '__main__': unittest.main()
