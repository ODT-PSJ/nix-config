+pragma ComponentBehavior: Bound
+import QtQuick
+import QtQuick.Controls
+import qs.Common
+
+// Screen rectangles represent compositor geometry; this is a spatial editor.
+Item {
+    id: root
+    property var displays: []
+    property string selectedName: ""
+    signal selected(string name)
+    signal moved(string name, int logicalX, int logicalY)
+    implicitHeight: 230
+    function dimensions(row) {
+        const match = row.mode.match(/^(\d+)x(\d+)/);
+        const rotated = ["90", "270", "flipped-90", "flipped-270"].indexOf(row.transform) >= 0;
+        const w = match ? Number(match[1]) : 1920;
+        const h = match ? Number(match[2]) : 1080;
+        return { w: Math.round((rotated ? h : w) / row.scale), h: Math.round((rotated ? w : h) / row.scale) };
+    }
+    readonly property var bounds: {
+        let x = 0, y = 0, right = 1, bottom = 1;
+        for (const row of displays) {
+            if (!row.enabled) continue;
+            const size = dimensions(row);
+            x = Math.min(x, row.x); y = Math.min(y, row.y);
+            right = Math.max(right, row.x + size.w); bottom = Math.max(bottom, row.y + size.h);
+        }
+        return { x: x, y: y, w: right - x, h: bottom - y };
+    }
+    readonly property real factor: Math.min((width - 48) / bounds.w, (height - 40) / bounds.h)
+    Repeater {
+        model: root.displays.filter(row => row.enabled)
+        Rectangle {
+            id: monitor
+            property real dragX: 0
+            property real dragY: 0
+            transform: Translate { x: monitor.dragX; y: monitor.dragY }
+            required property var modelData
+            readonly property var size: root.dimensions(modelData)
+            x: (modelData.x - root.bounds.x) * root.factor + (root.width - root.bounds.w * root.factor) / 2
+            y: (modelData.y - root.bounds.y) * root.factor + 20
+            width: Math.max(24, size.w * root.factor)
+            height: Math.max(24, size.h * root.factor)
+            radius: 8
+            color: modelData.name === root.selectedName ? Appearance.colors.colSecondaryContainer : Appearance.colors.colLayer2
+            border.width: modelData.name === root.selectedName ? 2 : 1
+            border.color: Appearance.colors.colPrimary
+            Label {
+                anchors.centerIn: parent
+                width: parent.width - 12
+                text: monitor.modelData.name + "\n" + monitor.size.w + " × " + monitor.size.h
+                horizontalAlignment: Text.AlignHCenter
+                wrapMode: Text.Wrap
+                font.pixelSize: 12
+                color: Appearance.colors.colOnSurface
+            }
+            MouseArea {
+                anchors.fill: parent
+                cursorShape: Qt.SizeAllCursor
+                property real startX: 0
+                property real startY: 0
+                property real savedFactor: 1
+                onPressed: mouse => {
+                    root.selected(monitor.modelData.name);
+                    const point = mapToItem(root, mouse.x, mouse.y);
+                    startX = point.x; startY = point.y; savedFactor = root.factor;
+                }
+                onPositionChanged: mouse => {
+                    if (!pressed) return;
+                    const point = mapToItem(root, mouse.x, mouse.y);
+                    monitor.dragX = point.x - startX; monitor.dragY = point.y - startY;
+                }
+                onCanceled: { monitor.dragX = 0; monitor.dragY = 0; }
+                onReleased: mouse => {
+                    const point = mapToItem(root, mouse.x, mouse.y);
+                    const dx = (point.x - startX) / savedFactor;
+                    const dy = (point.y - startY) / savedFactor;
+                    monitor.dragX = 0; monitor.dragY = 0;
+                    if (Math.abs(dx) + Math.abs(dy) > 20)
+                        root.moved(monitor.modelData.name, Math.round((monitor.modelData.x + dx) / 8) * 8, Math.round((monitor.modelData.y + dy) / 8) * 8);
+                }
+            }
+        }
+    }
+}
