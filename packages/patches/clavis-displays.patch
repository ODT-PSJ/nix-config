+#!/usr/bin/env python3
+"""Niri display transactions. The child owns rollback, independently of QML."""
+import fcntl
+import json
+import math
+import os
+from pathlib import Path
+import select
+import signal
+import subprocess
+import sys
+import tempfile
+
+STATE = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'clavis' / 'displays.json'
+TRANSFORMS = {'Normal': 'normal', '90': '90', '180': '180', '270': '270',
+              'Flipped': 'flipped', 'Flipped90': 'flipped-90',
+              'Flipped180': 'flipped-180', 'Flipped270': 'flipped-270'}
+
+
+def niri(*args):
+    result = subprocess.run(['niri', 'msg', *map(str, args)], capture_output=True, text=True, timeout=8)
+    if result.returncode:
+        raise RuntimeError(result.stderr.strip() or result.stdout.strip())
+    return result.stdout
+
+
+def outputs():
+    return json.loads(niri('--json', 'outputs'))
+
+
+def snapshot(raw):
+    result = []
+    for name, output in raw.items():
+        logical = output.get('logical')
+        mode_index = output.get('current_mode')
+        mode = output['modes'][mode_index] if mode_index is not None else None
+        result.append(dict(name=name, identity=[output.get(k) for k in ('make', 'model', 'serial')],
+                           enabled=logical is not None, mode=(f"{mode['width']}x{mode['height']}@{mode['refresh_rate']/1000:.3f}" if mode else 'auto'),
+                           scale=logical['scale'] if logical else 1,
+                           transform=TRANSFORMS.get(logical['transform'], 'normal') if logical else 'normal',
+                           x=logical['x'] if logical else 0, y=logical['y'] if logical else 0,
+                           vrr=output.get('vrr_enabled', False)))
+    return result
+
+
+def validate(rows, raw):
+    if not isinstance(rows, list) or not rows:
+        raise ValueError('没有可应用的显示器')
+    if len({row['name'] for row in rows}) != len(rows):
+        raise ValueError('显示器重复')
+    current = {row['name']: row for row in snapshot(raw)}
+    for row in rows:
+        name = row['name']
+        if name not in raw:
+            raise ValueError(f'显示器已断开：{name}')
+        if type(row['enabled']) is not bool or type(row['vrr']) is not bool:
+            raise ValueError('无效的开关状态')
+        scale = row['scale']
+        if not isinstance(scale, (float, int)) or not math.isfinite(scale) or not 0.5 <= scale <= 4:
+            raise ValueError('缩放必须在 50% 至 400% 之间')
+        if row['transform'] not in TRANSFORMS.values():
+            raise ValueError('无效的旋转方向')
+        for axis in ('x', 'y'):
+            if type(row[axis]) is not int or abs(row[axis]) > 32768:
+                raise ValueError('无效的屏幕坐标')
+        modes = {f"{m['width']}x{m['height']}@{m['refresh_rate']/1000:.3f}" for m in raw[name]['modes']}
+        if row['mode'] != 'auto' and row['mode'] not in modes:
+            raise ValueError(f'{name} 不支持所选显示模式')
+        if row['vrr'] and not raw[name].get('vrr_supported'):
+            raise ValueError(f'{name} 不支持可变刷新率')
+        row['identity'] = [raw[name].get(k) for k in ('make', 'model', 'serial')]
+        current[name] = row
+    if not any(row['enabled'] for row in current.values()):
+        raise ValueError('必须保留至少一块开启的屏幕')
+    return rows
+
+
+def apply(rows, best_effort=False):
+    errors = []
+    connected = outputs()
+    # Enable and configure usable screens before disabling any other screen.
+    commands = []
+    for row in rows:
+        if row['name'] not in connected or not row['enabled']:
+            continue
+        name = row['name']
+        commands.extend([(name, 'on'), (name, 'mode', row['mode']),
+                         (name, 'scale', row['scale']), (name, 'transform', row['transform']),
+                         (name, 'position', 'set', '--', row['x'], row['y'])])
+        if connected[name].get('vrr_supported'):
+            commands.append((name, 'vrr', 'on' if row['vrr'] else 'off'))
+    for command in commands:
+        try:
+            niri('output', *command)
+        except Exception as error:
+            if not best_effort:
+                raise
+            errors.append(str(error))
+    for row in rows:
+        if row['name'] in connected and not row['enabled']:
+            try:
+                live = outputs()
+                if sum(o.get('logical') is not None for o in live.values()) <= 1 and live[row['name']].get('logical'):
+                    continue
+                niri('output', row['name'], 'off')
+            except Exception as error:
+                if not best_effort:
+                    raise
+                errors.append(str(error))
+    if errors:
+        raise RuntimeError('; '.join(errors))
+
+
+def save(rows):
+    STATE.parent.mkdir(parents=True, exist_ok=True)
+    previous = json.loads(STATE.read_text()) if STATE.exists() else []
+    merged = {row['name']: row for row in previous}
+    merged.update({row['name']: row for row in rows})
+    fd, filename = tempfile.mkstemp(dir=STATE.parent, prefix='.displays-')
+    try:
+        with os.fdopen(fd, 'w') as stream:
+            json.dump(list(merged.values()), stream, ensure_ascii=False, indent=2)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(filename, STATE)
+    finally:
+        if os.path.exists(filename):
+            os.unlink(filename)
+
+
+def emit(event, **values):
+    try:
+        print(json.dumps(dict(event=event, **values), ensure_ascii=False), flush=True)
+    except BrokenPipeError:
+        pass  # A closed control center must not interrupt rollback.
+
+
+def transaction(rows):
+    raw = outputs()
+    before = snapshot(raw)
+    rows = validate(rows, raw)
+    def interrupted(*_):
+        raise RuntimeError('控制面板已关闭，恢复原显示设置')
+    signal.signal(signal.SIGTERM, interrupted)
+    signal.signal(signal.SIGHUP, interrupted)
+    try:
+        apply(rows)
+        emit('confirm', seconds=20)
+        ready, _, _ = select.select([sys.stdin], [], [], 20)
+        if ready and sys.stdin.readline().strip() == 'keep':
+            actual = snapshot(outputs())
+            requested = {row['name']: row for row in rows}
+            actual = [row if row['enabled'] else requested.get(row['name'], row) for row in actual]
+            save(actual)
+            emit('saved')
+            return
+    except Exception as error:
+        emit('error', message=str(error))
+    finally:
+        signal.signal(signal.SIGTERM, signal.SIG_IGN)
+        signal.signal(signal.SIGHUP, signal.SIG_IGN)
+    apply(before, best_effort=True)
+    emit('reverted')
+
+
+def main():
+    action = sys.argv[1]
+    if action == 'list':
+        raw = outputs()
+        rows = snapshot(raw)
+        if STATE.exists():
+            saved = {row['name']: row for row in json.loads(STATE.read_text())}
+            rows = [dict(saved[row['name']], enabled=False)
+                    if not row['enabled'] and row['name'] in saved
+                    and saved[row['name']].get('identity') == row['identity'] else row for row in rows]
+        emit('outputs', outputs=raw, settings=rows)
+        return
+    STATE.parent.mkdir(parents=True, exist_ok=True)
+    with (STATE.parent / 'displays.lock').open('w') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            if action == 'restore':
+                return
+            raise RuntimeError('另一项显示器调整正在进行')
+        if action == 'apply':
+            transaction(json.loads(sys.argv[2]))
+        elif action == 'restore' and STATE.exists():
+            raw = outputs()
+            rows = [row for row in json.loads(STATE.read_text()) if row['name'] in raw
+                    and row.get('identity') == [raw[row['name']].get(k) for k in ('make', 'model', 'serial')]]
+            if rows:
+                # If the only connected saved screen was disabled, keep it usable.
+                if not any(r['enabled'] for r in rows) and len(rows) == len(raw):
+                    rows[0]['enabled'] = True
+                apply(validate(rows, raw))
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except Exception as error:
+        emit('error', message=str(error))
+        sys.exit(1)
