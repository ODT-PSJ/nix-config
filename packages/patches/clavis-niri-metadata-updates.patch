+bool NiriWindowModel::updateWindow(const NiriWindow &window)
+{
+    for (int row = 0; row < m_windows.count(); ++row) {
+        NiriWindow &current = m_windows[row];
+        if (current.id != window.id)
+            continue;
+
+        QList<int> changedRoles;
+        const auto changed = [&changedRoles](bool value, Role role) {
+            if (value)
+                changedRoles.append(role);
+        };
+        changed(current.title != window.title, TitleRole);
+        changed(current.appId != window.appId, AppIdRole);
+        changed(current.appName != window.appName, AppNameRole);
+        changed(current.pid != window.pid, PidRole);
+        changed(current.workspaceId != window.workspaceId, WorkspaceIdRole);
+        changed(current.isFocused != window.isFocused, IsFocusedRole);
+        changed(current.isFloating != window.isFloating, IsFloatingRole);
+        changed(current.isUrgent != window.isUrgent, IsUrgentRole);
+        changed(current.layoutColumn != window.layoutColumn, LayoutColumnRole);
+        changed(current.layoutRow != window.layoutRow, LayoutRowRole);
+        changed(current.iconPath != window.iconPath, IconPathRole);
+        if (changedRoles.isEmpty())
+            return false;
+
+        current = window;
+        const QModelIndex changedIndex = index(row);
+        emit dataChanged(changedIndex, changedIndex, changedRoles);
+        return true;
+    }
+    return false;
+}
