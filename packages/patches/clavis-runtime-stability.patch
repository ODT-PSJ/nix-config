diff --git a/Modules/Launcher/AppPage.qml b/Modules/Launcher/AppPage.qml
index b5093d2..4735495 100644
--- a/Modules/Launcher/AppPage.qml
+++ b/Modules/Launcher/AppPage.qml
@@ -193,8 +193,23 @@ Item {
         if (filteredAppsModel.length > 0 && appsList.currentIndex >= 0) {
             let appData = filteredAppsModel[appsList.currentIndex]
             if (appData && appData.appObj)
-                appData.appObj.execute()
+                executeApp(appData.appObj)
             root.requestCloseLauncher()
         }
     }
+
+    function executeApp(app) {
+        if (app.runInTerminal || !app.command || app.command.length === 0) {
+            app.execute()
+            return
+        }
+
+        const command = ["systemd-run", "--user", "--scope", "--collect", "--quiet"]
+        if (app.workingDirectory)
+            command.push("--working-directory=" + String(app.workingDirectory))
+        command.push("--")
+        for (let argument of app.command)
+            command.push(String(argument))
+        Quickshell.execDetached(command)
+    }
 }
