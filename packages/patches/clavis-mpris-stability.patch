diff --git a/Services/MediaManager.qml b/Services/MediaManager.qml
--- a/Services/MediaManager.qml
+++ b/Services/MediaManager.qml
@@ -12,6 +12,62 @@ Item {

     // 保存用户手动指定的播放器
     property var manualActive: null
+    property var pendingPlayer: null
+    property string pendingMethod: ""
+    property bool commandBusy: false
+
+    function containsPlayer(player) {
+        const players = Mpris.players.values;
+        for (let index = 0; index < players.length; index++) {
+            if (players[index] === player)
+                return true;
+        }
+        return false;
+    }
+
+    function invoke(method, player) {
+        const target = player || root.active;
+        if (!target || !method || root.commandBusy)
+            return false;
+
+        root.pendingPlayer = target;
+        root.pendingMethod = String(method);
+        root.commandBusy = true;
+        commandDispatch.restart();
+        return true;
+    }
+
+    Timer {
+        id: commandDispatch
+        interval: 0
+        repeat: false
+        onTriggered: {
+            const target = root.pendingPlayer;
+            const method = root.pendingMethod;
+            root.pendingPlayer = null;
+            root.pendingMethod = "";
+
+            if (!target || !root.containsPlayer(target)
+                    || typeof target[method] !== "function") {
+                commandCooldown.restart();
+                return;
+            }
+
+            try {
+                target[method]();
+            } catch (error) {
+                console.warn("MPRIS command failed:", method, error);
+            }
+            commandCooldown.restart();
+        }
+    }
+
+    Timer {
+        id: commandCooldown
+        interval: 350
+        repeat: false
+        onTriggered: root.commandBusy = false
+    }

     // 核心计算逻辑：优先手动指定 -> 正在播放的 -> 列表第一个 -> null
     readonly property MprisPlayer active: {
